{
  "name": "incomeclaw",
  "version": "0.1.0",
  "private": true,
  "description": "IncomeClaw — five sovereign agents on 0G, built on SovereignClaw. Track 2 reference implementation.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:tavily": "tsx scripts/smoke-tavily.ts",
    "run-agent": "tsx scripts/run-agent.ts",
    "run-tool": "tsx scripts/run-tool.ts",
    "dev:orchestrator": "pnpm --filter @incomeclaw/orchestrator dev",
    "dev:web": "pnpm --filter @incomeclaw/web dev",
    "forge:bootstrap": "cd contracts && rm -rf lib && forge install --no-git foundry-rs/forge-std@v1.9.4 OpenZeppelin/openzeppelin-contracts@v5.1.0 && find lib -name .git -prune -exec rm -rf {} + && find lib -name .gitmodules -delete",
    "forge:build": "cd contracts && forge build",
    "forge:test": "cd contracts && forge test -vvv",
    "deploy:payment-receipt": "cd contracts && forge script script/Deploy.s.sol --rpc-url $RPC_URL --private-key $PRIVATE_KEY --broadcast"
  },
  "devDependencies": {
    "@eslint/js": "9.12.0",
    "@types/node": "22.7.5",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "eslint": "9.12.0",
    "eslint-plugin-boundaries": "5.0.1",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "tsx": "4.19.1",
    "turbo": "2.1.3",
    "typescript": "5.5.4",
    "typescript-eslint": "8.8.1"
  },
  "dependencies": {
    "@0gfoundation/0g-ts-sdk": "1.2.1",
    "@sovereignclaw/core": "0.2.0",
    "@sovereignclaw/memory": "0.1.0",
    "dotenv": "16.4.5",
    "ethers": "6.13.4",
    "pino": "9.4.0",
    "pino-pretty": "11.2.2",
    "zod": "3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
