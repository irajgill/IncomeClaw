{
  "name": "@incomeclaw/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "1.13.2",
    "@incomeclaw/agents": "workspace:^",
    "bullmq": "5.21.2",
    "dotenv": "16.4.5",
    "ethers": "6.13.4",
    "hono": "4.6.5",
    "ioredis": "5.4.1",
    "pino": "9.4.0",
    "pino-pretty": "11.2.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vitest": "2.1.2"
  }
}
